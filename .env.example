# Copy this file to ".env" and paste your Anthropic API key after the =
# Get a key at https://console.anthropic.com/ -> Settings -> API Keys
# The key is read ONLY by the local backend server (server/index.ts).
# It is never sent to the browser.

ANTHROPIC_API_KEY=

# Optional: override the model (defaults to claude-opus-4-8)
# MEALFORGE_MODEL=claude-opus-4-8

# Optional: port for the local API server (defaults to 8787)
# PORT=8787
