# Copy this file to ".env" and paste your Anthropic API key after the =
# Get a key at https://console.anthropic.com/ -> Settings -> API Keys
# Without a key the app runs in sample mode (screenshots saved, canned replies).
ANTHROPIC_API_KEY=

# Optional: which Claude model to use (default: claude-opus-5)
# SCREEN_BUDDY_MODEL=claude-opus-5

# Optional: where screenshots + log.jsonl are saved (default: ~/ScreenBuddy)
# SCREEN_BUDDY_DIR=

# --- Talk to a specific Claude Code session instead of the API ---
# SCREEN_BUDDY_BACKEND=claude-code
# Which session: "latest" = most recent session in SCREEN_BUDDY_PROJECT_DIR,
# or a specific Session ID (run /status inside Claude Code to see it)
# SCREEN_BUDDY_SESSION=latest
# Folder that session works in (where you ran `claude`)
# SCREEN_BUDDY_PROJECT_DIR=
# Path to the claude command if it's not on your PATH
# SCREEN_BUDDY_CLAUDE_BIN=
# Model for the buddy (e.g. sonnet for faster replies); default: the session's
# SCREEN_BUDDY_CLAUDE_MODEL=
# Minutes with no messages before claude is shut down to free the session
# SCREEN_BUDDY_IDLE_MIN=10

# --- Voice (🎙 / 🔊 buttons in the panel; both start off) ---
# Voice to text: Groq Whisper. Needed for "Hey Buddy".
# GROQ_API_KEY=
# Text to voice: Kokoro on Replicate (George). Without it, replies use the
# free built-in Windows voice.
# REPLICATE_API_TOKEN=
# Kokoro voice to use (default bm_george; see vendor/nkya-speech/kokoro.js)
# SCREEN_BUDDY_VOICE=bm_george
