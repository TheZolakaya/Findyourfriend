# Copy this file to ".env" and paste your Anthropic API key after the =
# Get a key at https://console.anthropic.com/ -> Settings -> API Keys
# Without a key the app runs in sample mode (screenshots saved, canned replies).
ANTHROPIC_API_KEY=

# Optional: which Claude model to use (default: claude-opus-5)
# SCREEN_BUDDY_MODEL=claude-opus-5

# Optional: where screenshots + log.jsonl are saved (default: ~/ScreenBuddy)
# SCREEN_BUDDY_DIR=
